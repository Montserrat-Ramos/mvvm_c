<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permite HTTP (sin TLS) mientras el backend esté en IP elástica con http -->
    <!-- Cuando tengas HTTPS, quita este bloque y usa solo cleartextTrafficPermitted=false -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">52.7.137.127</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
